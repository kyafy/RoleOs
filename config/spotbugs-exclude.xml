<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Spring injects these Port collaborators; they are intentionally retained by application services. -->
  <Match>
    <Class name="io.roleos.application.career.importing.ResumeImportApplicationService" />
    <Method name="&lt;init&gt;" />
    <Bug pattern="EI_EXPOSE_REP2" />
  </Match>
  <Match>
    <Class name="io.roleos.application.career.profile.CareerAssetApplicationService" />
    <Method name="&lt;init&gt;" />
    <Bug pattern="EI_EXPOSE_REP2" />
  </Match>
  <Match>
    <Class name="io.roleos.application.career.skill.SkillProvenanceApplicationService" />
    <Method name="&lt;init&gt;" />
    <Bug pattern="EI_EXPOSE_REP2" />
  </Match>
  <!-- Storage adapters retain Spring-managed JDBC/serialization collaborators and never expose them. -->
  <Match>
    <Class name="~io\.roleos\.storage\.career\..*" />
    <Method name="&lt;init&gt;" />
    <Bug pattern="EI_EXPOSE_REP2" />
  </Match>
  <Match>
    <Class name="~io\.roleos\.storage\.job\..*" />
    <Method name="&lt;init&gt;" />
    <Bug pattern="EI_EXPOSE_REP2" />
  </Match>
  <!-- 唯一索引并发竞争时，编排器只在未找到已创建搜索时原样传播持久化异常。 -->
  <Match>
    <Class name="io.roleos.job.service.JobSearchOrchestrator" />
    <Method name="start" />
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
  </Match>
  <!-- MVC controllers retain Spring-injected application services without returning them. -->
  <Match>
    <Class name="io.roleos.web.api.career.CareerAssetController" />
    <Method name="&lt;init&gt;" />
    <Bug pattern="EI_EXPOSE_REP2" />
  </Match>
  <Match>
    <Class name="io.roleos.web.api.skill.SkillController" />
    <Method name="&lt;init&gt;" />
    <Bug pattern="EI_EXPOSE_REP2" />
  </Match>
</FindBugsFilter>
