# 仅供本地开发使用。复制为 .env 后按需修改；不要提交 .env。
# 该默认密码只适用于本机 Docker PostgreSQL，不得用于任何共享或生产环境。
ROLEOS_POSTGRES_DB=roleos
ROLEOS_POSTGRES_USER=roleos_app
ROLEOS_POSTGRES_PASSWORD=roleos_local_dev_change_me
ROLEOS_POSTGRES_PORT=5432

# Spring Boot 启动时使用的连接信息。
ROLEOS_DATABASE_URL=jdbc:postgresql://localhost:5432/roleos
ROLEOS_DATABASE_USERNAME=roleos_app
ROLEOS_DATABASE_PASSWORD=roleos_local_dev_change_me
ROLEOS_SERVER_PORT=8080

# 默认关闭 OpenAPI UI，只有本地调试时才显式开启。
ROLEOS_OPENAPI_ENABLED=false

# 可选：用于本地 OWASP Dependency-Check 加速。不要提交真实 Key。
# NVD_API_KEY=
